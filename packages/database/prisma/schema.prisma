datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// User Identity & System Access
// ==========================================
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  fullName     String
  passwordHash String
  role         String       @default("QS_ENGINEER") // GLOBAL_ADMIN, COMMERCIAL_DIRECTOR, SENIOR_QS, QS_ENGINEER, ESTIMATOR, AUDITOR, VIEWER
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships     Membership[]
  createdProjects Project[]    @relation("CreatedProjects")

  @@index([email])
  @@index([role])
  @@map("users")
}

// ==========================================
// Organization (Multi-tenant boundary)
// ==========================================
model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  country         String       @default("LK") // ISO 3166-1 alpha-2 (Default Sri Lanka)
  currency        String       @default("LKR") // Default Currency LKR
  status          String       @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships Membership[]
  projects    Project[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// ==========================================
// Organization Membership (RBAC association)
// ==========================================
model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("QS_ENGINEER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// Project Context (Commercial & QS scope root)
// ==========================================
model Project {
  id                  String       @id @default(uuid())
  organizationId      String
  code                String       // e.g. "PRJ-CMB-001"
  name                String
  description         String?
  country             String       @default("LK")
  standard            String       @default("SLS_573") // SLS_573, CESMM4, NRM2, SMM7, POMI
  contractStandard    String?      // CIDA_SBD_01, CIDA_SBD_02, FIDIC_RED, etc.
  status              String       @default("PLANNING") // PLANNING, TENDERING, ACTIVE, COMMERCIAL_CLOSEOUT, FINAL_ACCOUNT, ARCHIVED
  currency            String       @default("LKR")
  createdById         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@index([standard])
  @@map("projects")
}
