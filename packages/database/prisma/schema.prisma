datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// User Identity & System Access
// ==========================================
model User {
  id              String       @id @default(uuid())
  email           String       @unique
  fullName        String
  passwordHash    String
  role            String       @default("QS_ENGINEER") // GLOBAL_ADMIN, COMMERCIAL_DIRECTOR, SENIOR_QS, QS_ENGINEER, ESTIMATOR, AUDITOR, VIEWER
  isActive        Boolean      @default(true)
  isEmailVerified Boolean      @default(false)
  accountStatus   String       @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships             Membership[]
  createdProjects         Project[]                @relation("CreatedProjects")
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuthAuditEvent[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

// ==========================================
// Authentication Sessions (Rotating Refresh Tokens)
// ==========================================
model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String    @default(uuid())
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// Email Verification Tokens
// ==========================================
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ==========================================
// Password Reset Tokens
// ==========================================
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// Authentication Audit Events
// ==========================================
model AuthAuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // REGISTER_SUCCESS, LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, LOGOUT_ALL, REFRESH_SUCCESS, REFRESH_REUSE_DETECTED, PASSWORD_CHANGE, PASSWORD_RESET_REQUESTED, PASSWORD_RESET_COMPLETED, EMAIL_VERIFIED, ACCOUNT_LOCKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("auth_audit_events")
}

// ==========================================
// Organization (Multi-tenant boundary)
// ==========================================
model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  country         String       @default("LK") // ISO 3166-1 alpha-2 (Default Sri Lanka)
  currency        String       @default("LKR") // Default Currency LKR
  status          String       @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships Membership[]
  projects    Project[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// ==========================================
// Organization Membership (RBAC association)
// ==========================================
model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("QS_ENGINEER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// Project Context (Commercial & QS scope root)
// ==========================================
model Project {
  id                  String       @id @default(uuid())
  organizationId      String
  code                String       // e.g. "PRJ-CMB-001"
  name                String
  description         String?
  country             String       @default("LK")
  standard            String       @default("SLS_573") // SLS_573, CESMM4, NRM2, SMM7, POMI
  contractStandard    String?      // CIDA_SBD_01, CIDA_SBD_02, FIDIC_RED, etc.
  status              String       @default("PLANNING") // PLANNING, TENDERING, ACTIVE, COMMERCIAL_CLOSEOUT, FINAL_ACCOUNT, ARCHIVED
  currency            String       @default("LKR")
  createdById         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@index([standard])
  @@map("projects")
}
