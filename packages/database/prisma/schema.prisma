datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// User Identity & System Access
// ==========================================
model User {
  id              String       @id @default(uuid())
  email           String       @unique
  fullName        String
  passwordHash    String
  role            String       @default("QS_ENGINEER") // GLOBAL_ADMIN, COMMERCIAL_DIRECTOR, SENIOR_QS, QS_ENGINEER, ESTIMATOR, AUDITOR, VIEWER
  isActive        Boolean      @default(true)
  isEmailVerified Boolean      @default(false)
  accountStatus   String       @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships             Membership[]
  createdProjects         Project[]                @relation("CreatedProjects")
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuthAuditEvent[]
  sentInvitations         OrganizationInvitation[] @relation("SentInvitations")
  projectMembers          ProjectMember[]
  uploadedDocuments       Document[]               @relation("UploadedDocuments")
  uploadSessions          DocumentUploadSession[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

// ==========================================
// Authentication Sessions (Rotating Refresh Tokens)
// ==========================================
model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String    @default(uuid())
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// Email Verification Tokens
// ==========================================
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ==========================================
// Password Reset Tokens
// ==========================================
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// Authentication Audit Events
// ==========================================
model AuthAuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // REGISTER_SUCCESS, LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, LOGOUT_ALL, REFRESH_SUCCESS, REFRESH_REUSE_DETECTED, PASSWORD_CHANGE, PASSWORD_RESET_REQUESTED, PASSWORD_RESET_COMPLETED, EMAIL_VERIFIED, ACCOUNT_LOCKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("auth_audit_events")
}

// ==========================================
// Organization (Multi-tenant boundary)
// ==========================================
model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  country         String       @default("LK") // ISO 3166-1 alpha-2 (Default Sri Lanka)
  currency        String       @default("LKR") // Default Currency LKR
  status          String       @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  settings        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships Membership[]
  projects    Project[]
  invitations OrganizationInvitation[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// ==========================================
// Organization Membership (RBAC association)
// ==========================================
model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("QS_ENGINEER") // OrganizationRole enum
  status         String       @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@map("memberships")
}

// ==========================================
// Project Context (Commercial & QS scope root)
// ==========================================
model Project {
  id                     String          @id @default(uuid())
  organizationId         String
  code                   String          // e.g. "PRJ-CMB-001"
  name                   String
  description            String?
  projectType            String          @default("COMMERCIAL") // ProjectType enum: RESIDENTIAL, COMMERCIAL, INDUSTRIAL, INFRASTRUCTURE, etc.
  status                 String          @default("PLANNING")   // ProjectStatus enum: PLANNING, DESIGN, TENDERING, PRE_CONSTRUCTION, UNDER_CONSTRUCTION, etc.
  location               String?         // City / site address / location details
  country                String          @default("LK")
  clientName             String?         // Employer / Client organization name
  contractorName         String?         // Main Contractor organization name
  consultantName         String?         // Lead Consultant / QS Consultant name
  projectManager         String?         // Project Manager reference / contact
  startDate              DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  estimatedContractValue Decimal?        @db.Decimal(15, 2)     // Exact monetary amount
  currency               String          @default("LKR")        // CurrencyCode
  standard               String          @default("SLS_573")    // MeasurementStandard
  contractStandard       String?                                // ContractStandard: CIDA_SBD_01, CIDA_SBD_02, FIDIC_RED, etc.
  measurementUnitSystem  String          @default("METRIC")     // UnitSystem: METRIC, IMPERIAL
  createdById            String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  archivedAt             DateTime?

  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy              User            @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)
  members                ProjectMember[]
  spatialNodes           SpatialNode[]
  workPackages           WorkPackage[]
  documents              Document[]
  uploadSessions         DocumentUploadSession[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
  @@index([projectType])
  @@index([status])
  @@index([standard])
  @@map("projects")
}

// ==========================================
// Construction Project Spatial Hierarchy
// ==========================================
model SpatialNode {
  id           String        @id @default(uuid())
  projectId    String
  parentNodeId String?
  nodeType     String        @default("BUILDING") // SITE, BUILDING, BLOCK, LEVEL, ZONE, ROOM, OTHER
  name         String
  code         String?       // e.g. "BLD-A", "L01", "RM-101"
  description  String?
  displayOrder Int           @default(0)
  status       String        @default("ACTIVE")   // ACTIVE, ARCHIVED
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentNode   SpatialNode?  @relation("SpatialHierarchy", fields: [parentNodeId], references: [id], onDelete: Cascade)
  childNodes   SpatialNode[]         @relation("SpatialHierarchy")
  documentLinks DocumentSpatialLink[]

  @@index([projectId])
  @@index([parentNodeId])
  @@index([nodeType])
  @@index([status])
  @@index([displayOrder])
  @@map("spatial_nodes")
}

// ==========================================
// Project Work Breakdown Structure (WBS)
// ==========================================
model WorkPackage {
  id              String        @id @default(uuid())
  projectId       String
  parentPackageId String?
  code            String        // Package code, e.g. "WP-01", "WP-01.01"
  name            String
  description     String?
  displayOrder    Int           @default(0)
  status          String        @default("ACTIVE") // ACTIVE, ARCHIVED
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentPackage   WorkPackage?  @relation("WBSHierarchy", fields: [parentPackageId], references: [id], onDelete: Cascade)
  childPackages   WorkPackage[]             @relation("WBSHierarchy")
  documentLinks   DocumentWorkPackageLink[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([parentPackageId])
  @@index([code])
  @@index([status])
  @@index([displayOrder])
  @@map("work_packages")
}

// ==========================================
// Organization Invitation
// ==========================================
model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           String       @default("QS_ENGINEER")
  tokenHash      String       @unique
  invitedById    String
  status         String       @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

// ==========================================
// Project Member (Project access grant)
// ==========================================
model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  userId     String
  role       String?  // Optional project-level override role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ==========================================
// Construction Project Document Control (ES-05 / Storage Foundation)
// ==========================================
model Document {
  id                 String                  @id @default(uuid())
  organizationId     String
  projectId          String
  reference          String                  // Document Reference / Code, unique in project (e.g. "DOC-ARCH-001")
  title              String
  description        String?
  category           String                  // DocumentCategory: ARCHITECTURAL_DRAWING, SPECIFICATION, etc.
  discipline         String                  @default("GENERAL") // DocumentDiscipline: ARCHITECTURE, STRUCTURE, etc.
  originalFilename   String
  fileFormat         String                  // PDF, DOCX, XLSX, CSV, TXT, IFC, DWG, DXF, PNG, JPG, etc.
  mimeType           String
  fileSizeBytes      BigInt
  storageObjectKey   String                  // Server-generated key: organizations/.../documents/.../objectId
  checksumSha256     String                  // Cryptographic SHA-256 integrity hash
  uploadStatus       String                  @default("READY") // PENDING, UPLOADING, QUARANTINED, VALIDATING, READY, REJECTED, FAILED, EXPIRED
  securityScanStatus String                  @default("CLEAN") // PENDING_SCAN, CLEAN, FLAGGED, UNSCANNED
  uploadedById       String
  archivedAt         DateTime?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy         User                    @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  spatialLinks       DocumentSpatialLink[]
  workPackageLinks   DocumentWorkPackageLink[]
  uploadSessions     DocumentUploadSession[]

  @@unique([projectId, reference])
  @@index([organizationId])
  @@index([projectId])
  @@index([category])
  @@index([discipline])
  @@index([fileFormat])
  @@index([uploadStatus])
  @@index([securityScanStatus])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("documents")
}

// ==========================================
// Document Upload Session (Lifecycle & Quarantine)
// ==========================================
model DocumentUploadSession {
  id                 String    @id @default(uuid())
  organizationId     String
  projectId          String
  userId             String
  documentId         String?   // Linked once document record is created
  declaredFilename   String
  declaredMimeType   String
  declaredSizeBytes  BigInt
  category           String
  discipline         String    @default("GENERAL")
  storageKey         String    // Quarantine path in MinIO
  status             String    @default("PENDING") // PENDING, UPLOADING, QUARANTINED, VALIDATING, READY, REJECTED, FAILED, EXPIRED
  checksumSha256     String?
  actualSizeBytes    BigInt?
  metadata           Json?     // Declared spatial/WBS links, client tags
  expiresAt          DateTime
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("document_upload_sessions")
}

// ==========================================
// Document - Spatial Breakdown Association
// ==========================================
model DocumentSpatialLink {
  id            String      @id @default(uuid())
  documentId    String
  spatialNodeId String
  createdAt     DateTime    @default(now())

  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  spatialNode   SpatialNode @relation(fields: [spatialNodeId], references: [id], onDelete: Cascade)

  @@unique([documentId, spatialNodeId])
  @@index([documentId])
  @@index([spatialNodeId])
  @@map("document_spatial_links")
}

// ==========================================
// Document - Work Breakdown Association
// ==========================================
model DocumentWorkPackageLink {
  id            String      @id @default(uuid())
  documentId    String
  workPackageId String
  createdAt     DateTime    @default(now())

  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@unique([documentId, workPackageId])
  @@index([documentId])
  @@index([workPackageId])
  @@map("document_work_package_links")
}
