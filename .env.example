# BuildMind AI v5.0 Environment Configuration Template

# System Environment
NODE_ENV=development
APP_ENV=local

# NestJS API (apps/api)
API_PORT=4000
API_HOST=localhost
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Next.js Web Frontend (apps/web)
PORT=3000
NEXT_PUBLIC_APP_NAME="BuildMind AI"
NEXT_PUBLIC_APP_VERSION="5.0.0"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_WORKER_URL=http://localhost:8000

# FastAPI AI Worker Service (services/ai-worker)
AI_WORKER_PORT=8000
AI_WORKER_HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=buildmind_app
POSTGRES_PASSWORD=buildmind_dev_password_change_in_prod
POSTGRES_DB=buildmind_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://buildmind_app:buildmind_dev_password_change_in_prod@localhost:5432/buildmind_db?schema=public

# Redis Configuration (Cache & Message Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# MinIO / S3-Compatible Object Storage (CAD/BIM Drawings & Documents)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_buildmind_access
S3_SECRET_KEY=minio_buildmind_secret_change_in_prod
S3_BUCKET_DRAWINGS=buildmind-drawings
S3_BUCKET_DOCUMENTS=buildmind-documents
S3_REGION=us-east-1

# Security & Future Authentication Gates
JWT_SECRET=super_secret_buildmind_jwt_signing_key_replace_in_prod_min_32_chars
JWT_EXPIRES_IN=86400
